# PraniDoctor User App — local environment (copy to .env)

# Used by scripts/run_dev_device.ps1 → flutter --dart-define flags.



APP_ENV=dev



# ---------------------------------------------------------------------------

# PORTS (defaults match repo)

# ---------------------------------------------------------------------------

# Backend (pranidoctor-backend):  PORT=3000  → mobile API

# Admin web (pranidoctor-web):     3001       → browser only (not used by app)



API_PORT=3000

WEB_PORT=3001



# ---------------------------------------------------------------------------

# API URL — physical Android phone on same WiFi (REQUIRED)

# ---------------------------------------------------------------------------

# 1. .\scripts\detect_lan_ip.ps1

# 2. Windows Firewall: allow inbound TCP 3000 (Private)

# 3. Backend: cd pranidoctor-backend && npm run dev

API_BASE_URL=http://192.168.10.111:3000

# Optional: separate upload/CDN origin (defaults to API_BASE_URL when empty)
UPLOAD_URL=http://192.168.10.111:3000

# Dev fallback when API_BASE_URL is empty (debug builds only)
DEV_WIFI_HOST=192.168.10.111



# Alternative: build URL from host + port (when API_BASE_URL is empty)

# API_HOST=192.168.10.111



# Android Emulator → PC host:

# API_BASE_URL=http://10.0.2.2:3000



# Optional admin web reference (shown on Connection Check screen)

# WEB_BASE_URL=http://192.168.10.111:3001



# ---------------------------------------------------------------------------

# Network

# ---------------------------------------------------------------------------

API_CONNECT_TIMEOUT_SEC=30

API_RECEIVE_TIMEOUT_SEC=30

LOG_NETWORK=true



# ---------------------------------------------------------------------------

# Features

# ---------------------------------------------------------------------------

ENABLE_PUSH=false

PRIVACY_POLICY_URL=https://pranidoctor.com/privacy



# ---------------------------------------------------------------------------

# Staging / production

# ---------------------------------------------------------------------------

# APP_ENV=staging

# API_BASE_URL=https://staging-api.your-domain.com



# APP_ENV=production

# API_BASE_URL=https://api.your-domain.com

